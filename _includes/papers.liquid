{% assign t = site.data.site_text[page.lang] %}
<div class="publications">
  <section id="journal"><h2>{{ t.published }}</h2>
    {% bibliography --query @article %}
  </section>
  <section id="preprints"><h2>{{ t.preprints }}</h2>
    {% bibliography --query @unpublished %}
  </section>
  <p class="equal-note"><sup>*</sup> {{ t.equal }}</p>
</div>
